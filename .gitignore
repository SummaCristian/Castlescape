# Build output (CMake presets build into skeleton/build)
build/
out/
cmake-build-*/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
CPackConfig.cmake
CPackSourceConfig.cmake
_deps/

# Compiled shaders (regenerated from source/shaders/*.vert|.frag|.comp by CMake)
*.spv

# Compiled objects / binaries
*.o
*.obj
*.so
*.dylib
*.dll
*.exe

# IDE / editor
.vscode/
.idea/
*.swp

# clangd index cache
.cache/

# graphify output (knowledge graph of this repo). Regenerable, and node ids embed the
# absolute paths of whoever generated it, so the graph itself is not shareable.
# The semantic extraction cache IS shared: it is content-addressed and machine-independent,
# so a teammate's /graphify rebuild reuses it and costs no tokens.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/

# Live workspace behind graphify-lectures/lectures/: the text extracted from the
# professor's slide PDFs, plus the graphify working directory that queries it.
# The finished graph next to it (graph.html / graph.json / GRAPH_REPORT.md) IS committed;
# this is only what is needed to re-query or --update it. The extracted slide text is the
# professor's material to distribute, not ours, which is the other reason it stays out.
graphify-lectures/lectures/workspace/

# OS cruft
.DS_Store
Thumbs.db
