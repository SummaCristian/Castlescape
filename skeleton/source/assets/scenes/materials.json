// Per-model BRDF parameters, for the Cook-Torrance model (E06 slides 38-47).
// See include/custom/SceneMaterials.hpp for how they reach the shader.
//
//   specularColor (mS)  color of the highlight. White for every dielectric:
//                       the highlight takes the color of the lamp, not of the
//                       object. Tinted only for metals (E06/L09 slide 69).
//   roughness (rho)     width of the microfacet distribution. 0 is a mirror,
//                       1 is completely matte. This is the knob you actually
//                       tune, and unlike the old specular exponent it has a
//                       scale you can reason about by looking at the object.
//   F0                  fraction reflected when looking straight down at the
//                       surface. It is ~0.04 for essentially EVERY dielectric,
//                       so it is copied, not chosen. Metals are far higher.
//   k                   diffuse share of the BRDF, specular gets (1 - k).
//                       High for dielectrics. Ignored on the entries that set
//                       "metallic", which have no diffuse component at all.
//
// Plus one switch that picks the lighting path rather than tuning it:
//
//   metallic            shade this model as a conductor: no diffuse lobe, and
//                       an indirect term that REFLECTS the room instead of
//                       scattering it (CookTorrance.frag, metalAmbient()).
//                       With it on, specularColor is no longer "colour of the
//                       highlight" but the material's own reflectance colour,
//                       and mS * F0 should land on the metal's measured value.
//                       See Material::metallic in SceneMaterials.hpp.
//
// Plus one parameter that isn't a BRDF term at all:
//
//   ambientWeight       this model's share of INDIRECT light, overriding the
//                       scene's "weight" in lights.json. NO model sets one
//                       today: the whole level is enclosed and torch-lit, so
//                       every one of them inherits the scene's 0.05. The
//                       ground plane was the last holdout at 0.20 and gave it
//                       up when the sun did -- see its entry below.
//                       It exists because hemispheric ambient has no visibility
//                       term: nothing in it can tell a corridor from a
//                       courtyard, so the number has to be authored. Add one
//                       here the moment a level has two lighting conditions in
//                       the same frame again.
//
//                       The default is the INDOOR one because the game is
//                       played indoors -- a model added here and left alone
//                       should come out lit like the room it sits in, not like
//                       a courtyard.
//
// Anything not listed here gets "default".
{
	"default": { "specularColor": [1.0, 1.0, 1.0], "roughness": 0.6, "F0": 0.04, "k": 0.9 },

	"models": {
		// The ground plane (Plane.gltf, scaled 100x in scene.json). Dry dirt and
		// cobbles: about as rough as a surface gets, and almost purely diffuse.
		//
		// It used to carry "ambientWeight": 0.20, four times the scene's indoor
		// default, on the grounds that it was the one model genuinely under the
		// open sky. That is dead twice over now. The castle exterior that stood
		// on it -- walls, towers, gate, keep, steps, the road, the crates, the
		// flag and the brass gate lanterns -- came out of scene.json a while
		// back, leaving the plane bare; and lights.json has no sun any more, so
		// there is no sky above it either. A share four times everyone else's,
		// of an indirect term that is now firelight bounced off dungeon stone,
		// would just make an empty plane the brightest surface in the level, lit
		// by torches it is nowhere near.
		//
		// So it inherits the scene's 0.05 like everything else, which is the
		// honest answer while nothing out there emits: the plane is lit by the
		// same nothing the rest of the level is. Putting the sun back means
		// putting this override back with it -- they were always one decision.
		"floor": { "roughness": 0.92, "F0": 0.04, "k": 0.96 },

		// Dungeon set (Dracula's Castle Assetpack, see README credits), which
		// since the exterior came out is the whole scene. Three categories:
		// rough and near-fully-diffuse for the stone pieces, a touch of sheen
		// for the wood, rougher still for cloth. Candle, plate, skull and torch
		// are left on "default": too small and varied in surface (wax, bone,
		// metal+wood) to lump into one entry.
		//
		// Nothing below sets "ambientWeight": these are the enclosed models, so
		// they inherit the scene's indoor 0.05 from lights.json, and that is the
		// whole reason the default is the indoor value. This is the answer to
		// "the rooms have a ceiling, so why is there sky light in them":
		// hemispheric ambient has no visibility term at all, so before the E17
		// blend the sealed corridors collected exactly as much indirect light as
		// the open courtyard, and the ceiling overhead changed nothing.
		//
		// It is an authored guess at enclosure, not real occlusion. The honest
		// version is the AO map E14 samples ([TODO 5b], aoMap); the MGCG pack
		// ships albedo only, so that has to be baked before it can be read.
		"dungeonFloor":   { "roughness": 0.85, "F0": 0.04, "k": 0.93 },
		"dungeonWall":    { "roughness": 0.80, "F0": 0.04, "k": 0.93 },
		// Coffered stone ceiling (SM_StoneCeiling_01, modelled for this project
		// on the kit's 7.2 grid). Its texture is ours too: the kit has none for
		// a ceiling, and every stone it does have reads wrong overhead -- the
		// floor's is far too light, and the wall's plain brick field sits at
		// luminance 63 against the 50 of the wall surface a player actually
		// sees, because that surface gets its darkness from mortar lines and
		// arch recesses with the AO baked in, which a flat ceiling has none of.
		// tools/make_ceiling_texture.py crops that same brick field and scales
		// it down to 50, so it is literally the wall's stone at the wall's
		// tone. Hence the same BRDF values as "dungeonWall".
		//
		// "interior" used to be the flag that made this match, back when a
		// diffuse surface still read the hemispheric ambient: without it a
		// downward-facing ceiling got the darker, brown-toned "ground" half
		// on its own, 1.80x darker than what the walls got. That indirect
		// path is gone now (diffuse surfaces take torch bounce only, see
		// CookTorrance.frag), so this ceiling's brightness today comes from
		// bounce reaching it same as any other surface, and "interior" here
		// is a leftover no-op for a non-metal material -- harmless, kept for
		// the history above rather than pulled for its own sake.
		//
		// Instances sit at y = 6.213,
		// i.e. 0.02 (the common riser) + 6.1929, the exact height of
		// SM_WallStraight_01, so the beams seat flush on the wall tops with no
		// overlapping coplanar faces to z-fight.
		"dungeonCeiling": { "roughness": 0.80, "F0": 0.04, "k": 0.93, "interior": true },
		"dungeonCorner":  { "roughness": 0.80, "F0": 0.04, "k": 0.93 },
		// Split door (see scene.json): stone wall half keeps the same values
		// as the other dungeon stone; the wood-and-iron leaf gets the same
		// touch of sheen as the other wood pieces above.
		"dungeonDoorWall":  { "roughness": 0.80, "F0": 0.04, "k": 0.93 },
		"dungeonDoorPanel": { "roughness": 0.55, "F0": 0.05, "k": 0.90 },
		// The chains and padlock on a locked door (tools/make_door_lock.py):
		// wrought iron and brass, and with "key" below the only metals left in
		// the scene. Both carry "metallic", and it is the flag rather than the
		// numbers that does the work here.
		//
		// These are also the entries that show what these parameters are for: a
		// metal has no diffuse component at all ("metallic", which forces k to
		// 0), reflects strongly even head-on (high F0), and colours what it
		// reflects with itself instead of with the lamp (mS is not white).
		//
		// The reason is what the two pieces are made of. Nearly everything you
		// see on a real chain is a reflection of the room, not the chain's own
		// colour, and the diffuse ambient every other entry in this file uses
		// cannot produce that: it hands a surface a colour chosen by which way
		// it FACES, multiplied by its albedo. On these two that failed at both
		// ends. The chains' UVs sample the door texture's wrought-iron band
		// (albedo ~0.03 linear), so the albedo multiply erased the term and
		// every link out of direct torchlight went to black; the padlock's
		// sample the key's solid brass, so the leftover diffuse share painted
		// it flat orange, and it read as plastic. Neither is a tuning problem.
		// "metallic" drops the diffuse lobe and swaps the indirect term for
		// metalAmbient(), which reflects the hemisphere off the surface
		// instead of scattering it -- the chain now catches the room the way
		// iron does, and the brass is brass rather than orange.
		//
		// The numbers are then just the two metals, measured, with mS * F0
		// landing on the real reflectance: (0.55, 0.56, 0.57) for iron, which
		// is all but neutral and so leaves mS near white, and (0.92, 0.72,
		// 0.42) for brass, the same pair as "key" below. That product is the
		// quantity to preserve if either number is retuned: F0 alone is how
		// bright, mS alone is what hue, and only together are they "brass".
		// Wrought iron on a dungeon
		// door is rougher than a lantern's polished bowl, and rougher again
		// than the cast padlock hanging off it, hence 0.62 against 0.40. The
		// chains went from 0.45 to 0.62 deliberately: pitted iron on a cellar
		// door barely catches a highlight, and the tighter lobe was reading as
		// chrome. F0 stays on iron's measured 0.57 -- that is what keeps it
		// metal; roughness is the "how polished" knob. No "k": the shader
		// forces it to 0 for a metal, and writing one
		// here would only look like it did something.
		//
		// "interior" stays, and now for one reason instead of two. It pins the
		// hemisphere blend at 0.5 (Material::interiorAmbient), and that is
		// simply true of these two -- they hang inside an archway and see no
		// sky whatever, the same as dungeonCeiling above, so their reflection
		// should be one constant dungeon colour rather than a sky-to-ground
		// gradient. It also happens to settle the coloured fringe that several
		// earlier passes chased through the specular values: upper minus lower
		// is (0.15, 0.375, 0.80), eight times stronger in blue than in red, and
		// the blend is driven purely by how far up the normal points, so around
		// a tube -- whose normal sweeps the whole circle -- the ambient ALONE
		// laid a cool edge along the top of every link and a warm one
		// underneath. That gradient traced the silhouette exactly and was owed
		// to no light at all, which is why no amount of specular tuning ever
		// touched it. It is not the torches in the room beyond: those are
		// behind a closed leaf and 1.24 units of wall, and every light's direct
		// term is multiplied by shadowFactor().
		//
		// What "interior" is NOT is occlusion. It is the authored guess the
		// header describes, and the honest fix is the baked AO the shader keeps
		// asking for and the MGCG pack cannot supply.
		//
		// One artefact these values do not claim to cure, stated so nobody
		// re-tunes them chasing it: a round silhouette is nearly all grazing
		// angle, where Schlick's F climbs towards 1 and BRDF()'s denominator
		// runs to its clamp, so the specular is at its strongest on exactly the
		// pixels that outline the piece. Measured: making the chains nearly
		// matte drops those pixels by 58%, which pins it on the specular term
		// rather than on the ambient, the mesh density or the post chain (there
		// is no chromatic aberration in Composite.frag). metalAmbient() at
		// least does not add to it -- its Fresnel is capped at (1 - roughness)
		// for this reason -- but the direct term still does. Anything further
		// belongs in CookTorrance.frag as a change reviewed against every
		// material in the game, not in this file and not by flattening the
		// metals until the symptom goes quiet.
		"doorChains01": { "specularColor": [0.96, 0.98, 1.00], "roughness": 0.62, "F0": 0.57, "metallic": true, "interior": true },
		// Matched to "key" below: same brass, same measured mS * F0, and now
		// the same 0.40 roughness so the lock and the key that opens it read as
		// one metal. It had been 0.32 (a shade more polished), which only made
		// the pair look like two different brasses side by side.
		"padlock01":    { "specularColor": [1.00, 0.78, 0.46], "roughness": 0.40, "F0": 0.92, "metallic": true, "interior": true },

		// The pickup key, same brass as "padlock01" -- it is the object whose
		// albedo the padlock borrows, so leaving it on "default"
		// was the same failure the padlock comment describes: the leftover
		// diffuse share painted the solid-brass albedo flat orange and it read
		// as a yellow plastic toy. "metallic" drops that lobe and reflects the
		// room instead. mS * F0 = (0.92, 0.72, 0.42), the same measured brass.
		//
		// The pack ships Key_MetallicSmoothness / Key_Normal beside the albedo
		// (assets/textures/Miscellaneous/), which this renderer has no sampler
		// for; roughness 0.40 is that smoothness map's mean (1 - 0.60), so the
		// one number we can carry matches the texture we cannot. "interior":
		// the key lives and is carried in the dungeon, same as the padlock.
		"key":          { "specularColor": [1.00, 0.78, 0.46], "roughness": 0.40, "F0": 0.92, "metallic": true, "interior": true },
		// The bookcase that hides the secret passage (tools/make_bookshelf.py).
		// Same values as "dungeonDoorPanel" and for the same reason: its atlas
		// (SM_Bookshelf_01.png) is a copy of that leaf's own, with only the
		// book spines painted into a corner that was empty, so the carcass is
		// literally the same wood and has to shade like it. A mobile that
		// shaded differently from the doors would be the one object in the room
		// announcing that it isn't furniture -- which is exactly what a secret
		// door must not do. The spines ride the same values: leather and cloth
		// are near enough to matt wood at this roughness, and one material per
		// model is all the loader gives us anyway.
		//
		// "interior": it stands inside a doorway with a wall on either side and
		// sees no sky, same as the chains and the ceiling beams.
		"bookshelf01": { "roughness": 0.55, "F0": 0.05, "k": 0.90, "interior": true },
		// The book that opens it. Tooled leather over a gilt block: rougher
		// than varnished wood and almost purely diffuse, which is what keeps
		// the crimson reading as cloth-grained hide rather than as the polished
		// panel it sits on. Deliberately NOT metallic despite the gold on the
		// page edges -- the gilding is a stripe of the banner texture, not the
		// material, and the key next door already owns the one brass in the
		// castle.
		"book01": { "roughness": 0.78, "F0": 0.04, "k": 0.94, "interior": true },
		"dungeonBarrel":  { "roughness": 0.55, "F0": 0.05, "k": 0.90 },
		"dungeonTable":   { "roughness": 0.55, "F0": 0.05, "k": 0.90 },
		"dungeonChair":   { "roughness": 0.55, "F0": 0.05, "k": 0.90 },
		"dungeonCarpet":  { "roughness": 0.95, "F0": 0.03, "k": 0.97 },
		"dungeonBanner":  { "roughness": 0.90, "F0": 0.03, "k": 0.95 },

		// No "flame" entry: the flames run on their own pipeline and their own
		// shader pair (Flame.vert/frag), which generates their colour
		// procedurally and reads nothing from here. See scene.json.
		//
		// The wall torch, and one of the only models in the scene with
		// castsShadow off. Its bracket sits within centimetres of the point
		// light it carries -- between the wall and the flame -- and an occluder
		// that close blocks a huge cone of the light's sphere, which is why the
		// torches appeared to light only a wedge in front of them. See
		// Material::castsShadow in SceneMaterials.hpp for why this is not
		// solvable with bias instead. It is still lit and drawn normally; it
		// just isn't an occluder.
		"dungeonTorch": { "castsShadow": false },
		// The held torch (SM_Torch_Held_01, "dungeonTorchHeld" in scene.json).
		// Unlike "dungeonTorch" above, this one DOES occlude -- it's a SEPARATE
		// model id, so it doesn't inherit that entry, and left on "default"
		// (castsShadow: true) is exactly what its floor pose wants: lying
		// unlit on the ground before pickup, it's a static prop like any
		// other and should darken the stone under it the same way a barrel
		// would.
		//
		// The self-occlusion problem "dungeonTorch" describes doesn't apply
		// to this one: its own point light only turns on once the player
		// lights it (flameBurning() gates it out of the light list while
		// unlit), and once lit, recordCubeSlotFaces excludes ownerInst from
		// its OWN cube map regardless of this flag. What this flag alone
		// can't tell apart is the floor pose from the carried one -- that
		// distinction (and why the carried torch is exempted separately,
		// pending a player model to explain a floating shadow) lives in
		// main.cpp's CheatFlags::handTorchModelCastsShadowWhenHeld.
		"dungeonTorchHeld": { "castsShadow": true },

		// The ghosts, not occluders either -- the only entry here that is a
		// PERFORMANCE decision rather than a lighting one, so it is worth saying
		// why plainly.
		//
		// A ghost is the only thing in this level that moves continuously, and
		// the cube shadow maps are cached precisely because nothing else does
		// (see lastRenderedOccupant in main.cpp). Every frame a ghost walks
		// within a torch's reach, that torch's affected cube faces have to be
		// cleared and redrawn: at SHADOW_CUBE_RES that is megabytes of render
		// target rewritten per face per frame, times however many torches it is
		// standing among, and the machinery around it (per-face invalidation,
		// per-face culling, an async submit) got the cost down without getting
		// it down far enough on this hardware.
		//
		// What is being given up is small: a translucent apparition that casts a
		// hard black silhouette was never the more convincing of the two
		// readings.
		//
		// That last sentence used to be an excuse, because the ghosts were not
		// translucent -- they were opaque grey props, and an opaque prop with no
		// shadow is a bug you can see. They have since been moved to the
		// "Spectral" technique (shaders/spectral/Spectral.frag), which draws them
		// alpha-blended, unlit and emissive. Now the flag below and the way they
		// look agree with each other: you can see the wall through a ghost, so
		// there is nothing there to stop a torch.
		//
		// Turning it back on is still just this one flag as far as the shadow
		// machinery goes -- the mover tracking in main.cpp keys off castsShadow
		// rather than off "is this a ghost" -- but it would now also need the
		// ghosts moved back to the CookTorrance technique in scene.json, since
		// the shadow passes walk SC.TI[0] and nothing else. The doors still use
		// it: they move rarely enough that a swing costs one re-capture and
		// nothing after it.
		//
		// specularColor is repurposed by Spectral.frag, which computes no
		// specular term (it computes no BRDF at all): there it is the colour the
		// apparition EMITS when calm. A cold desaturated blue-green, the one
		// colour in the palette neither the torches (orange), the hunt flames
		// (violet) nor the focus glow (gold) occupy, so a ghost across a lit
		// room never reads as another light source. The hunt tint it shifts to
		// is in the shader, not here: it is one shared cue rather than a
		// per-model surface property.
		"ghost": { "castsShadow": false, "specularColor": [0.55, 0.86, 0.92] }
	},

	// Per-INSTANCE overrides, keyed by the instance id in scene.json. Each one
	// starts from its model's material above and changes only the fields named,
	// same layering as default -> model.
	//
	// The three locked doors each want a different metal for the key and its
	// padlock, so the ring reads as three distinct keys instead of one brass
	// key collected three times. They all share the "key" / "padlock01" models,
	// so the distinction can only live here. The gold pair keeps the model
	// material (the brass authored on "key" already reads as gold), so only the
	// silver and bronze doors appear below.
	//
	// metallic is inherited from the model, so specularColor IS the reflectance
	// colour of the metal (not a highlight tint) -- see Material::metallic in
	// SceneMaterials.hpp. The albedo texture is not sampled for a metal at all,
	// which is why re-skinning Key_Albedo did nothing: the colour has to be set
	// here.
	//
	// Silver: near-neutral, a shade cool, and polished (low roughness) so it
	// throws a tight bright reflection the warm metals don't.
	//
	// Bronze: deliberately pushed well past "measured bronze" toward brown-
	// orange and darkened, because the room is lit almost entirely by orange
	// torches -- a physically-accurate bronze under that light still reads as
	// "dark brass", and the three keys have to be told apart at a glance. Also
	// the roughest of the three: a cast, handled bronze key, not a cut one.
	"instances": {
		"hbKeyIron":      { "specularColor": [0.92, 0.95, 0.99], "F0": 0.97, "roughness": 0.26 },
		"hbDoorNPadlock": { "specularColor": [0.92, 0.95, 0.99], "F0": 0.97, "roughness": 0.26 },

		"rbKeyBronze":     { "specularColor": [0.82, 0.44, 0.22], "F0": 0.80, "roughness": 0.60 },
		"hbDoorSPadlock":  { "specularColor": [0.82, 0.44, 0.22], "F0": 0.80, "roughness": 0.60 }
	}
}
