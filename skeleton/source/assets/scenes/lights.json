// The scene's light sources. See include/custom/SceneLights.hpp for the three
// types and what every field means.
//
//   direct   direction + color. No position, no decay.
//   point    position + color + decay (g, beta).
//   spot     a point light plus an aim direction and two cone angles.
//
//   g        distance at which the light is exactly its stated color
//   beta     falloff exponent: 0 constant, 1 inverse-linear, 2 inverse-square
//
// Positions are world coordinates, and "instance" + "offset" hangs a light off a
// scene.json instance instead of repeating its coordinates.
{
	// Indirect lighting, hemispheric (E07 slides 47-54): two colors blended by
	// which way a surface faces. "upper" is what a surface pointing at the sky
	// receives, "lower" what one pointing at the ground receives, "direction" is
	// the axis they blend along, i.e. world up.
	//
	// Cool and dim above, warm and darker below: skylight is blue, bounce off a
	// dirt courtyard is brown. Getting these two the same color would throw away
	// the entire point of the model and leave a constant ambient term.
	"ambient": {
		"upper": [0.10, 0.13, 0.20],
		"lower": [0.07, 0.055, 0.04],
		"direction": [0.0, 1.0, 0.0]
	},

	"lights": [
		// The sun. "direction" is the way the light TRAVELS, so this one comes
		// from above and from the +Z side, which is what puts light on the face
		// of the keep you see when you spawn.
		//
		// Parked high and still. It used to orbit (orbitSpeed -0.5, a full day
		// every 12 minutes), but with no shadow mapping the sun keeps shining
		// once it passes below the horizon, lighting everything from underneath.
		// Setting orbitSpeed to 0 sidesteps that until either shadows exist or
		// the scene is re-lit for evening.
		//
		// Roughly 55 degrees above the horizon rather than straight down: a sun
		// at [0,-1,0] would leave every vertical wall in the castle with no
		// direct light at all, since dot(N, L) would be 0 on all of them.
		// The small X tilts it slightly off the scene's axis of symmetry, so the
		// east and west towers aren't lit identically.
		{
			"id": "sun",
			"type": "direct",
			"direction": [0.25, -0.82, -0.52],
			"color": [1.0, 0.98, 0.92],
			"orbitSpeed": 0.0,
			"castsShadow": true
		},

		// The dungeon wall torches (five here, plus torchDV at the end of this
		// file, six in all). Offset is the flame's position relative
		// to its torch instance's own origin -- NOT rotated by the instance's
		// eulerAngles (SceneLights adds it in world space), which is why the two
		// walls need opposite-signed X: the west-wall torches are rotated 180 on
		// Y so their cup points +X into the room, the east-wall ones are
		// unrotated and point -X. See Flame_01/TorchSkull_01 placement in
		// scene.json for the matching mesh offsets.
		//
		// flicker enables the per-frame sine-sum jitter in SceneLights::update
		// (no data here beyond the switch -- amplitude defaults to
		// flickerStrength below). g/beta close to the lanterns': same kind of
		// small warm source.
		//
		// No "castsShadow" on any of these six: shadow-casting for every
		// point light in the scene (these six, the dl room's colored
		// torches, the two candles) is now handed out at RUNTIME by
		// main.cpp's dynamic shadow-cube pool, by proximity to the player,
		// instead of being fixed forever for whichever torches happened to
		// be implemented first -- see updateDynamicShadowSlots() there.
		// These six still work as ordinary (non-shadow) lights through this
		// file exactly as before; TorchFlame's own per-frame copy of each
		// (main.cpp) is the one that gets a real shadow when the dynamic
		// pool assigns it one.
		{
			"id": "torchW1",
			"type": "point",
			"instance": "dhTorchW1",
			"offset": [0.47, 0.40, 0.0],
			"color": [1.0, 0.55, 0.20],
			"g": 3.0,
			"beta": 1.4,
			"flicker": true,
			"flickerStrength": 0.35
		},
		{
			"id": "torchW2",
			"type": "point",
			"instance": "dhTorchW2",
			"offset": [0.47, 0.40, 0.0],
			"color": [1.0, 0.55, 0.20],
			"g": 3.0,
			"beta": 1.4,
			"flicker": true,
			"flickerStrength": 0.35
		},
		{
			"id": "torchE1",
			"type": "point",
			"instance": "dhTorchE1",
			"offset": [-0.47, 0.40, 0.0],
			"color": [1.0, 0.55, 0.20],
			"g": 3.0,
			"beta": 1.4,
			"flicker": true,
			"flickerStrength": 0.35
		},
		{
			"id": "torchE2",
			"type": "point",
			"instance": "dhTorchE2",
			"offset": [-0.47, 0.40, 0.0],
			"color": [1.0, 0.55, 0.20],
			"g": 3.0,
			"beta": 1.4,
			"flicker": true,
			"flickerStrength": 0.35
		},
		{
			"id": "torchDC",
			"type": "point",
			"instance": "dcTorchE",
			"offset": [-0.47, 0.40, 0.0],
			"color": [1.0, 0.55, 0.20],
			"g": 3.0,
			"beta": 1.4,
			"flicker": true,
			"flickerStrength": 0.35
		},

		// The dv alcove's torch. Same as the other five above: no fixed
		// "castsShadow" any more, it competes for the dynamic pool instead.
		{
			"id": "torchDV",
			"type": "point",
			"instance": "dvTorch",
			"offset": [-0.47, 0.40, 0.0],
			"color": [1.0, 0.55, 0.20],
			"g": 3.0,
			"beta": 1.4,
			"flicker": true,
			"flickerStrength": 0.35
		}
	]
}
